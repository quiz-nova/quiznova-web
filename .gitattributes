# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf
*.ts text eol=lf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.svg text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
